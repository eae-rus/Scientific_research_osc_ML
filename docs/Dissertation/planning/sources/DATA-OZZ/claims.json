    {
      "claim_id": "OZZ-DATA-ZONE",
      "source_id": "DATA-OZZ",
      "source_sha256": "f4993e3efd914536101e056dbe4d8b210bbff0404d7c04688b5b5270d2cad5f3",
      "source_statements": [
        {
          "locator": "word/document.xml:P0119",
          "text": "Максимальный бросок часто наблюдается не во время протекания ОЗЗ, а в момент ликвидации аварии коммутационной аппаратурой (Рис. 5). В рамках данного исследования такие броски не относились к перенапряжениям, вызванным непосредственно ОЗЗ, однако их учёт мог бы существенно изменить статистику в области высоких кратностей (>2,5 Uном). Отметим, что данный вопрос является особо важным, и требует отдельно обсуждения."
        }
      ],
      "neutral_ru": "Коммутационные броски при ликвидации аварии не включены в перенапряжения самого ОЗЗ.",
      "experiment_id": "OZZ-SELECT/EXPERT",
      "scope": "Поднабор выбранных реальных осциллограмм ОЗЗ; не все ОЗЗ энергосистемы.",
      "evidence": {
        "exclusion": "switching spikes outside SPEF zone"
      },
      "limitations": [
        "Не максимум всех перенапряжений записи."
      ],
      "verification_status": "source_values_checked; primary_scalar_data_not_recomputed",
