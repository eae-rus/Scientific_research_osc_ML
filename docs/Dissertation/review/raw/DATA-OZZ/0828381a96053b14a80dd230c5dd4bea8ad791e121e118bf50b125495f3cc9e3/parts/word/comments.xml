te="2025-10-14T09:26:00Z" w:initials="EAE"><w:p w14:paraId="735F5B44" w14:textId="5A110271" w:rsidR="00851658" w:rsidRDefault="00851658" w:rsidP="00851658"><w:pPr><w:pStyle w:val="ab"/></w:pPr><w:r><w:rPr><w:rStyle w:val="aa"/></w:rPr><w:annotationRef/></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>Нуу</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t>… Да, это очень сильно мешает нам сейчас, и первичные алгоритмы косячат. Про это как раз раздел.</w:t></w:r></w:p><w:p w14:paraId="7AC83591" w14:textId="77777777" w:rsidR="00851658" w:rsidRDefault="00851658" w:rsidP="00851658"><w:pPr><w:pStyle w:val="ab"/></w:pPr></w:p><w:p w14:paraId="014DD293" w14:textId="70D5B37B" w:rsidR="00851658" w:rsidRDefault="00851658" w:rsidP="00851658"><w:pPr><w:pStyle w:val="ab"/></w:pPr><w:r><w:t xml:space="preserve">А так, ещё наш БАВР </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>сиё</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> не любит и может ложно себя вести, но это не совсем к такой осциллограмме.</w:t></w:r></w:p></w:comment><w:comment w:id="38" w:author="Евдаков Алексей" w:date="2025-10-14T11:15:00Z" w:initials="EAE"><w:p w14:paraId="406EED33" w14:textId="41918247" w:rsidR="00426477" w:rsidRPr="00070DCF" w:rsidRDefault="00426477" w:rsidP="00426477"><w:pPr><w:pStyle w:val="ab"/></w:pPr><w:r><w:rPr><w:rStyle w:val="aa"/></w:rPr><w:annotationRef/></w:r><w:r w:rsidRPr="00426477"><w:t>72f8a458baa9f9af869a74009e920be7</w:t></w:r></w:p></w:comment><w:comment w:id="39" w:author="Евдаков Алексей" w:date="2025-10-14T11:37:00Z" w:initials="EAE"><w:p w14:paraId="1D95D493" w14:textId="23EE3FA2" w:rsidR="003D4D38" w:rsidRDefault="003D4D38"><w:pPr><w:pStyle w:val="ab"/></w:pPr><w:r><w:rPr><w:rStyle w:val="aa"/></w:rPr><w:annotationRef/></w:r><w:r w:rsidRPr="006B68C9"><w:t>d8e57e692fd29447706bec5885daebf3</w:t></w:r></w:p></w:comment><w:comment w:id="41" w:author="Valery Valery" w:date="2025-10-13T15:23:00Z" w:initials="VV"><w:p w14:paraId="0A9E89B5" w14:t