></w:p><w:p w14:paraId="0EE6CAEF" w14:textId="1346F804" w:rsidR="0006788F" w:rsidRDefault="0006788F"><w:pPr><w:pStyle w:val="ab"/></w:pPr><w:r><w:t>Процессов?</w:t></w:r></w:p></w:comment><w:comment w:id="46" w:author="Евдаков Алексей" w:date="2025-10-14T09:09:00Z" w:initials="EAE"><w:p w14:paraId="6A0C721D" w14:textId="7EA0EC4E" w:rsidR="004772FD" w:rsidRPr="004772FD" w:rsidRDefault="004772FD"><w:pPr><w:pStyle w:val="ab"/></w:pPr><w:r><w:rPr><w:rStyle w:val="aa"/></w:rPr><w:annotationRef/></w:r><w:r><w:t xml:space="preserve">Ну это </w:t></w:r><w:r><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>GPT</w:t></w:r><w:r w:rsidRPr="004772FD"><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">нравится, но согласен, из </w:t></w:r><w:r><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>IT</w:t></w:r><w:r w:rsidRPr="004772FD"><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t>чёт, я обычно там слова такие слышу, когда говорим про модельки и обработку картинок))</w:t></w:r></w:p></w:comment><w:comment w:id="47" w:author="Евдаков Алексей" w:date="2025-10-14T09:12:00Z" w:initials="EAE"><w:p w14:paraId="3D3A9E57" w14:textId="5D59C01C" w:rsidR="004772FD" w:rsidRDefault="004772FD"><w:pPr><w:pStyle w:val="ab"/></w:pPr><w:r><w:rPr><w:rStyle w:val="aa"/></w:rPr><w:annotationRef/></w:r><w:r><w:t xml:space="preserve">Вот блин… А как сказать по </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>русски</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t>-то, вроде и формы сигнала, но как-то плохо звучит, ладно сейчас извернусь.</w:t></w:r></w:p></w:comment><w:comment w:id="51" w:author="Valery Valery" w:date="2025-10-13T15:25:00Z" w:initials="VV"><w:p w14:paraId="24A57BB6" w14:textId="433FC013" w:rsidR="0006788F" w:rsidRDefault="0006788F"><w:pPr><w:pStyle w:val="ab"/></w:pPr><w:r><w:rPr><w:rStyle w:val="aa"/></w:rPr><w:annotationRef/></w:r><w:r><w:t>Ну РЗА добавь тогда, выход на РЗА</w:t></w:r></w:p></w:comment><w:comment w:id="52" w:author="Евдаков Алексей" w:date="2025-10-14T0