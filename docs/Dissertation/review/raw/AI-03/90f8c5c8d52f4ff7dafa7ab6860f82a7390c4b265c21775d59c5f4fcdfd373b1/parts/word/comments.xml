sidR="00D649B4" w:rsidRDefault="00D649B4"><w:pPr><w:pStyle w:val="af"/></w:pPr><w:r><w:t>Можно ещё поменять слово вектор, если оно не смущает. Прост в математике из этой сфере оно значит «массив чисел»</w:t></w:r></w:p></w:comment><w:comment w:id="13" w:author="Алексей Евдаков" w:date="2026-06-05T21:42:00Z" w:initials="АЕ"><w:p w14:paraId="3A3927E8" w14:textId="65CFE1C6" w:rsidR="00B47DA4" w:rsidRDefault="00B47DA4"><w:pPr><w:pStyle w:val="af"/></w:pPr><w:r><w:rPr><w:rStyle w:val="ae"/></w:rPr><w:annotationRef/></w:r><w:r><w:t>Добавил термин</w:t></w:r><w:r w:rsidRPr="00B47DA4"><w:t xml:space="preserve"> </w:t></w:r><w:r><w:t xml:space="preserve">и формулу </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>softmax</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t>, если нужно, можно ещё по</w:t></w:r><w:r w:rsidR="006826F5"><w:t>д</w:t></w:r><w:r><w:t>робнее.</w:t></w:r></w:p><w:p w14:paraId="0FE0EBE7" w14:textId="77777777" w:rsidR="00B47DA4" w:rsidRDefault="00B47DA4"><w:pPr><w:pStyle w:val="af"/></w:pPr></w:p><w:p w14:paraId="604161D4" w14:textId="0000E2AB" w:rsidR="00B47DA4" w:rsidRPr="00B47DA4" w:rsidRDefault="00B47DA4"><w:pPr><w:pStyle w:val="af"/></w:pPr><w:r><w:t>Теперь дальше используется именно он</w:t></w:r></w:p></w:comment><w:comment w:id="16" w:author="Евдаков Алексей" w:date="2026-06-04T16:47:00Z" w:initials="EAE"><w:p w14:paraId="0AB8452A" w14:textId="609ED091" w:rsidR="00CB615F" w:rsidRPr="00CB615F" w:rsidRDefault="00CB615F" w:rsidP="00CB615F"><w:pPr><w:pStyle w:val="af"/><w:rPr><w:b/></w:rPr></w:pPr><w:r w:rsidRPr="003814B4"><w:rPr><w:b/><w:color w:val="FF0000"/></w:rPr><w:t>От Андрея замечание</w:t></w:r></w:p><w:p w14:paraId="72FF4C3A" w14:textId="6B8845BE" w:rsidR="00F84922" w:rsidRDefault="00F84922"><w:pPr><w:pStyle w:val="af"/></w:pPr><w:r><w:rPr><w:rStyle w:val="ae"/></w:rPr><w:annotationRef/></w:r><w:r><w:t>Перевести вс</w:t></w:r><w:r w:rsidR="00CB615F"><w:t>е иностранные слова</w:t></w:r></w:p></w:comment><w:comment w:id="17" w:author="Евдаков Алексей" w:date="2026-06-04T16:47:00Z" w:initials="EAE"><w:p w14:paraId="20825911" w14:textId="7BE6158C" w:rsidR="001150D1" w:rsidRDefault="001150D1"><w:pPr><w:pStyle w:val="af"/></w:pPr><w:r><w:rPr><w:rStyle w:val="ae"/></w:rPr><w:annotationRef/></w:r><w:r><w:t>Да и всех рисунков касается</w:t></w:r></w:p></w:comment><w:comment w:id="18" w:author="Евдаков Алексей" w:date="2026-04-20T15:00:00Z" w:initials="EAE"><w:p w14:paraId="7F2A5EA8" w14:textId="3206D8C4" w:rsidR="00044AA6" w:rsidRDefault="00044AA6"><w:pPr><w:pStyle w:val="af"/></w:pPr><w:r><w:rPr><w:rStyle w:val="ae"/></w:rPr><w:annotationRef/></w:r><w:r><w:t>Ну… Пусть пока такое, суть в том, что модель смотрит на всё сразу и с нужным «весом» оценивает влияние какого-то участка на данную зону.</w:t></w:r></w:p></w:comment><w:comment w:id="19" w:author="Евдаков Алексей" w:date="2026-06-04T16:49:00Z" w:initials="EAE"><w:p w14:paraId="4C011807" w14:textId="77777777" w:rsidR="00984710" w:rsidRPr="00CB615F" w:rsidRDefault="00984710" w:rsidP="00984710"><w:pPr><w:pStyle w:val="af"/><w:rPr><w:b/></w:rPr></w:pPr><w:r><w:rPr><w:rStyle w:val="ae"/></w:rPr><w:annotationRef/></w:r><w:r w:rsidRPr="003814B4"><w:rPr><w:b/><w:color w:val="FF0000"/></w:rPr><w:t>От Андрея замечание</w:t></w:r></w:p><w:p w14:paraId="7420FB33" w14:textId="435B3477" w:rsidR="00984710" w:rsidRDefault="00984710" w:rsidP="00984710"><w:pPr><w:pStyle w:val="af"/></w:pPr><w:r><w:rPr><w:rStyle w:val="ae"/></w:rPr><w:annotationRef/></w:r><w:r><w:t>Этот текст должен быть в линию.</w:t></w:r></w:p></w:comment><w:comment w:id="20" w:author="Евдаков Алексей" w:date="2026-06-04T16:50:00Z" w:initials="EAE"><w:p w14:paraId="1CF880CA" w14:textId="3727F724" w:rsidR="00984710" w:rsidRDefault="00984710"><w:pPr><w:pStyle w:val="af"/></w:pPr><w:r><w:rPr><w:rStyle w:val="ae"/></w:rPr><w:annotationRef/></w:r><w:r><w:t>Если честно, не понял почему и как…</w:t></w:r></w:p></w:comment><w:comment w:id="21" w:author="Евдаков Алексей" w:date="2026-06-04T16:49:00Z" w:initials="EAE"><w:p w14:paraId="5C56B6DB" w14:textId="29BF4373" w:rsidR="00984710" w:rsidRDefault="00984710"><w:pPr><w:pStyle w:val="af"/></w:pPr><w:r><w:rPr><w:rStyle w:val="ae"/></w:rPr><w:annotationRef/></w:r><w:r><w:t xml:space="preserve">Может перестать лепить везде эту фразу «архитектура», ну прям плодит текст без какого-либо смысла. Прост от того, что «эти люди не </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:t>привыкли»…</w:t></w:r><w:proofErr w:type="gramEnd"/></w:p></w:comment><w:comment w:id="23" w:author="Алексей Евдаков" w:date="2026-06-05T21:49:00Z" w:initials="АЕ"><w:p w14:paraId="1616BD75" w14:textId="1613DA2C" w:rsidR="00AD5FB5" w:rsidRDefault="00AD5FB5"><w:pPr><w:pStyle w:val="af"/></w:pPr><w:r><w:rPr><w:rStyle w:val="ae"/></w:rPr><w:annotationRef/></w:r><w:r><w:t>Переписал подробнее. Или может непонятно, что значит «</w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>полносвязные</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t>»? Прост для меня это прям базовый термин…</w:t></w:r></w:p></w:comment><w:comment w:id="24" w:author="Евдаков Алексей" w:date="2026-06-04T16:52:00Z" w:initials="EAE"><w:p w14:paraId="4B187E78" w14:textId="1DA5DD9C" w:rsidR="003A0404" w:rsidRDefault="003A0404"><w:pPr><w:pStyle w:val="af"/></w:pPr><w:r><w:rPr><w:rStyle w:val="ae"/></w:rPr><w:annotationRef/></w:r><w:r><w:t>Прост для информации – это чисто моя вставка, чтобы удобнее отслеживать разворот листа. Само собой будет удалено в итоговой версии.</w:t></w:r></w:p></w:comment><w:comment w:id="25" w:author="Евдаков Алексей" w:date="2026-04-20T17:25:00Z" w:initials="EAE"><w:p w14:paraId="5EBF0EDE" w14:textId="107BB373" w:rsidR="00044AA6" w:rsidRDefault="00044AA6"><w:pPr><w:pStyle w:val="af"/></w:pPr><w:r><w:rPr><w:rStyle w:val="ae"/></w:rPr><w:annotationRef/></w:r><w:r><w:t>Проверить, нет ли дублирования с разделом 2.</w:t></w:r></w:p></w:comment><w:comment w:id="29" w:author="Евдаков Алексей" w:date="2026-04-20T17:36:00Z" w:initials="EAE"><w:p w14:paraId="65A25E67" w14:textId="1F059C93" w:rsidR="009631CD" w:rsidRDefault="009631CD"><w:pPr><w:pStyle w:val="af"/></w:pPr><w:r><w:rPr><w:rStyle w:val="ae"/></w:rPr><w:annotationRef/></w:r><w:r><w:t>Не сильно важное это, конечно для статьи… Хотя при расчётах вызывало проблемы. Так что пока оставил.</w:t></w:r></w:p></w:comment><w:comment w:id="31" w:author="Евдаков Алексей" w:date="2026-04-21T10:13:00Z" w:initials="EAE"><w:p w14:paraId="1574583E" w14:textId="5F282245" w:rsidR="00213550" w:rsidRDefault="00213550"><w:pPr><w:pStyle w:val="af"/></w:pPr><w:r><w:rPr><w:rStyle w:val="ae"/></w:rPr><w:annotationRef/></w:r><w:r><w:t xml:space="preserve">Явно надо будет перерисовать, чтобы лучше помещалось)) И пока сложно. Но уже </w:t></w:r><w:r w:rsidR="00167820"><w:t>рабочее</w:t></w:r><w:r><w:t xml:space="preserve"> хотя бы</w:t></w:r></w:p></w:comment><w:comment w:id="32" w:author="Алексей Евдаков" w:date="2026-06-05T21:54:00Z" w:initials="АЕ"><w:p w14:paraId="443A97CF" w14:textId="5E0CB26A" w:rsidR="00E97C86" w:rsidRDefault="00E97C86"><w:pPr><w:pStyle w:val="af"/></w:pPr><w:r><w:rPr><w:rStyle w:val="ae"/></w:rPr><w:annotationRef/></w:r><w:r><w:t>Надо глянуть, может нигде далее не используется</w:t></w:r></w:p></w:comment><w:comment w:id="35" w:author="Евдаков Алексей" w:date="2026-04-21T15:21:00Z" w:initials="EAE"><w:p w14:paraId="4E12F048" w14:textId="12965ECF" w:rsidR="00C77046" w:rsidRDefault="00C77046"><w:pPr><w:pStyle w:val="af"/></w:pPr><w:r><w:rPr><w:rStyle w:val="ae"/></w:rPr><w:annotationRef/></w:r><w:r><w:t>Можно и формулу привести в случае чего, но… Пусть пока так.</w:t></w:r></w:p></w:comment><w:comment w:id="36" w:author="Евдаков Алексей" w:date="2026-04-21T15:28:00Z" w:initials="EAE"><w:p w14:paraId="7EDAD8A2" w14:textId="12DFF415" w:rsidR="00A50FC0" w:rsidRDefault="00A50FC0"><w:pPr><w:pStyle w:val="af"/></w:pPr><w:r><w:rPr><w:rStyle w:val="ae"/></w:rPr><w:annotationRef/></w:r><w:r><w:t>П</w:t></w:r><w:r w:rsidRPr="00A50FC0"><w:t>еременная, которая принадлежит множеству, обозначенному квадратными скобками</w:t></w:r></w:p></w:comment><w:comment w:id="37" w:author="Евдаков Алексей" w:date="2026-04-21T15:29:00Z" w:initials="EAE"><w:p w14:paraId="3F6B9796" w14:textId="10939FC6" w:rsidR="00A50FC0" w:rsidRDefault="00A50FC0"><w:pPr><w:pStyle w:val="af"/></w:pPr><w:r><w:rPr><w:rStyle w:val="ae"/></w:rPr><w:annotationRef/></w:r><w:proofErr w:type="gramStart"/><w:r><w:t>Наверное</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:t xml:space="preserve"> надо будет переписать, уж слишком программистки… </w:t></w:r></w:p></w:comment><w:comment w:id="40" w:author="Евдаков Алексей" w:date="2026-04-21T11:03:00Z" w:initials="EAE"><w:p w14:paraId="22D047AB" w14:textId="67B5B267" w:rsidR="00D812A2" w:rsidRDefault="00D812A2"><w:pPr><w:pStyle w:val="af"/></w:pPr><w:r><w:rPr><w:rStyle w:val="ae"/></w:rPr><w:annotationRef/></w:r><w:r><w:t>Есть в картинке</w:t></w:r></w:p></w:comment><w:comment w:id="44" w:author="Алексей Евдаков" w:date="2026-06-05T22:03:00Z" w:initials="АЕ"><w:p w14:paraId="19257822" w14:textId="28A05088" w:rsidR="00C75A9C" w:rsidRDefault="00C75A9C"><w:pPr><w:pStyle w:val="af"/></w:pPr><w:r><w:rPr><w:rStyle w:val="ae"/></w:rPr><w:annotationRef/></w:r><w:r><w:t>Можно старый термин и не вставлять, но решил указать. Всё же для осуществляемых действий и того, как идёт обучение – он базовый.</w:t></w:r></w:p></w:comment><w:comment w:id="45" w:author="Евдаков Алексей" w:date="2026-04-21T16:01:00Z" w:initials="EAE"><w:p w14:paraId="08985EE8" w14:textId="30EB1E09" w:rsidR="00E86C9D" w:rsidRDefault="00E86C9D"><w:pPr><w:pStyle w:val="af"/></w:pPr><w:r><w:rPr><w:rStyle w:val="ae"/></w:rPr><w:annotationRef/></w:r><w:r><w:t xml:space="preserve">Вот эта галочка, или как-то так – это в статистики и подобном символ предсказанного значения, ну или </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>апроксимации</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t>. Может прямо напишу потом, ибо если бы я сейчас не учился в ШАД (Яндексе) – то и не знал бы об этом и не понял бы такую запись)</w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:t>)</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:t xml:space="preserve"> Хоть она математически корректна…</w:t></w:r></w:p></w:comment><w:comment w:id="46" w:author="Евдаков Алексей" w:date="2026-04-21T16:10:00Z" w:initials="EAE"><w:p w14:paraId="27D38BDA" w14:textId="0A14F0E5" w:rsidR="001D2FE4" w:rsidRDefault="001D2FE4"><w:pPr><w:pStyle w:val="af"/></w:pPr><w:r><w:rPr><w:rStyle w:val="ae"/></w:rPr><w:annotationRef/></w:r><w:r><w:t>Вводил такие коэффициенты. Здесь можно бы убрать.</w:t></w:r></w:p></w:comment><w:comment w:id="48" w:author="Евдаков Алексей" w:date="2026-04-20T15:00:00Z" w:initials="EAE"><w:p w14:paraId="48C89A1B" w14:textId="77777777" w:rsidR="00C456EB" w:rsidRDefault="00C456EB" w:rsidP="00C456EB"><w:pPr><w:pStyle w:val="af"/></w:pPr><w:r><w:rPr><w:rStyle w:val="ae"/></w:rPr><w:annotationRef/></w:r><w:r><w:t>Ну… Пусть пока такое, суть в том, что модель смотрит на всё сразу и с нужным «весом» оценивает влияние какого-то участка на данную зону.</w:t></w:r></w:p></w:comment><w:comment w:id="49" w:author="Евдаков Алексей" w:date="2026-04-21T16:17:00Z" w:initials="EAE"><w:p w14:paraId="149BE376" w14:textId="35B59A7D" w:rsidR="001D2FE4" w:rsidRPr="007902D9" w:rsidRDefault="001D2FE4"><w:pPr><w:pStyle w:val="af"/></w:pPr><w:r><w:rPr><w:rStyle w:val="ae"/></w:rPr><w:annotationRef/></w:r><w:r><w:t xml:space="preserve">Взята из </w:t></w:r><w:r w:rsidR="007902D9"><w:t xml:space="preserve">языковой модели </w:t></w:r><w:r w:rsidR="007902D9"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>BERT</w:t></w:r><w:r w:rsidR="007902D9"><w:t>, можно и другое поискать…</w:t></w:r></w:p></w:comment><w:comment w:id="50" w:author="Алексей Евдаков" w:date="2026-04-21T23:41:00Z" w:initials="АЕ"><w:p w14:paraId="4E1EE57A" w14:textId="79DBBF53" w:rsidR="00A132E5" w:rsidRDefault="00A132E5"><w:pPr><w:pStyle w:val="af"/></w:pPr><w:r><w:rPr><w:rStyle w:val="ae"/></w:rPr><w:annotationRef/></w:r><w:r><w:t>Во, нашёл лучше картинку, нужна такая всё же.</w:t></w:r></w:p></w:comment><w:comment w:id="51" w:author="Алексей Евдаков" w:date="2026-06-05T22:07:00Z" w:initials="АЕ"><w:p w14:paraId="0A97E461" w14:textId="36B4A554" w:rsidR="00EF3369" w:rsidRDefault="00EF3369"><w:pPr><w:pStyle w:val="af"/></w:pPr><w:r><w:rPr><w:rStyle w:val="ae"/></w:rPr><w:annotationRef/></w:r><w:r><w:t>Или «</w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:t>блок»…</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:t xml:space="preserve"> Прост без конца не хочется пихать «блок».</w:t></w:r></w:p></w:comment><w:comment w:id="52" w:author="Алексей Евдаков" w:date="2026-08-08T15:45:00Z" w:initials="АЕ"><w:p w14:paraId="4484AF31" w14:textId="44386CB5" w:rsidR="00312BFB" w:rsidRDefault="00312BFB"><w:pPr><w:pStyle w:val="af"/></w:pPr><w:r><w:rPr><w:rStyle w:val="ae"/></w:rPr><w:annotationRef/></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00312BFB"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-US"/></w:rPr><w:t>Evdakov</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rStyle w:val="ae"/><w:rFonts w:eastAsia="SimSun"/></w:rPr><w:annotationRef/></w:r><w:r w:rsidRPr="00312BFB"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-US"/></w:rPr><w:t xml:space="preserve">, A., </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00312BFB"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-US"/></w:rPr><w:t>Filatova</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00312BFB"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-US"/></w:rPr><w:t xml:space="preserve">, G., </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00312BFB"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-US"/></w:rPr><w:t>Yablokov</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00312BFB"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-US"/></w:rPr><w:t xml:space="preserve">, A. et al. A dataset of real-world oscillograms from electrical power grids. </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rs