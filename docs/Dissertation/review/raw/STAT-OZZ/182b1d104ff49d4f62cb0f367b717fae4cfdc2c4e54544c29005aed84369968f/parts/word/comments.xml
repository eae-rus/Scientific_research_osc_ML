0B" w:rsidRDefault="000C2A0B" w:rsidP="000C2A0B"><w:pPr><w:pStyle w:val="ab"/><w:rPr><w:highlight w:val="yellow"/></w:rPr></w:pPr><w:r w:rsidRPr="000C2A0B"><w:rPr><w:highlight w:val="yellow"/></w:rPr><w:t>4) !!Когда будет уточнена разметка ОЗЗ и перенапряжений от них – то обновить рисунки.!!</w:t></w:r></w:p><w:p w14:paraId="34575976" w14:textId="61C366AB" w:rsidR="000C2A0B" w:rsidRDefault="000C2A0B" w:rsidP="000C2A0B"><w:pPr><w:pStyle w:val="ab"/></w:pPr><w:r w:rsidRPr="000C2A0B"><w:rPr><w:highlight w:val="yellow"/></w:rPr><w:t>5) !!так же поправить ВСЕ цифры, так они могут чутка измениться!!</w:t></w:r></w:p></w:comment><w:comment w:id="9" w:author="Алексей Евдаков" w:date="2025-10-12T21:25:00Z" w:initials="АЕ"><w:p w14:paraId="7F79EC23" w14:textId="2FA29C66" w:rsidR="00EE07CC" w:rsidRDefault="00EE07CC"><w:pPr><w:pStyle w:val="ab"/></w:pPr><w:r><w:rPr><w:rStyle w:val="aa"/></w:rPr><w:annotationRef/></w:r><w:r><w:t>Пока так указал, ибо в идеале – это ссылка на другую статью</w:t></w:r></w:p></w:comment><w:comment w:id="11" w:author="Алексей Евдаков" w:date="2025-10-12T21:22:00Z" w:initials="АЕ"><w:p w14:paraId="4A185E7C" w14:textId="1C319B8F" w:rsidR="00EE07CC" w:rsidRDefault="00EE07CC"><w:pPr><w:pStyle w:val="ab"/></w:pPr><w:r><w:rPr><w:rStyle w:val="aa"/></w:rPr><w:annotationRef/></w:r><w:r><w:t xml:space="preserve">Так-то, этот </w:t></w:r><w:r w:rsidR="000C2A0B"><w:t>раздел, а</w:t></w:r><w:r><w:t xml:space="preserve"> точнее даже вот эта картинка главные в статье и по началу идея была только на это.</w:t></w:r></w:p></w:comment><w:comment w:id="12" w:author="Valery Valery" w:date="2025-10-13T15:44:00Z" w:initials="VV"><w:p w14:paraId="5E5EB1C8" w14:textId="77777777" w:rsidR="009B2562" w:rsidRDefault="009B2562"><w:pPr><w:pStyle w:val="ab"/></w:pPr><w:r><w:rPr><w:rStyle w:val="aa"/></w:rPr><w:annotationRef/></w:r><w:r><w:t>Опасно</w:t></w:r></w:p><w:p w14:paraId="2731D286" w14:textId="77777777" w:rsidR="009B2562" w:rsidRDefault="009B2562"><w:pPr><w:pStyle w:val=